// STEP 2 — Параметры публикации
{
  "step": 2,
  "type": "form",
  "title": "Параметры публикации",
  "description": "Уточните детали текста",
  "disabled": false,
  "modes": [
    {
      "name": "default",
      "label": null,
      "fieldsGroups": [
        {
          "groupName": "ticketOptions",
          "groupLabel": "CTA",
          "groupFields": [
            {
              "name": "callToAction",
              "type": "checkbox",
              "label": "Добавить призыв к покупке",
              "required": false,
              "value": false
            },
            {
              "name": "mentionBoxOffice",
              "type": "checkbox",
              "label": "Упомянуть кассу",
              "required": false,
              "value": false
            },
            {
              "name": "ticketUrl",
              "type": "text",
              "label": "Ссылка на билеты",
              "required": false,
              "value": null,
              "validation": {"isUrl": true, "maxLength": 500}
            },
            {
              "name": "pushkinCard",
              "type": "checkbox",
              "label": "Пушкинская карта",
              "required": false,
              "value": false
            }
          ]
        },
        {
          "groupName": "textSettings",
          "groupLabel": "Настройки текста",
          "groupFields": [
            {
              "name": "format",
              "type": "select",
              "label": "Формат поста",
              "required": true,
              "value": null,
              "options": [
                {"value": "short",  "label": "Короткий (300–500)" },
                {"value": "medium", "label": "Средний (800–1200)" },
                {"value": "long",   "label": "Длинный (1500–2200)"}
              ]
            },
            {
              "name": "emoji",
              "type": "checkbox",
              "label": "Использовать эмодзи",
              "required": false,
              "value": false
            },
            {
              "name": "hashtags",
              "type": "text",
              "label": "Хэштеги",
              "required": false,
              "value": null,
              "validation": {"maxLength": 500}
            },
            {
              "name": "tone",
              "type": "select",
              "label": "Тональность",
              "required": true,
              // В value можно передавать значение не только когда форма disabled
              // Но и когда форма будет заполняться. Тогда переданное значение будет "по умолчанию", это норм идея
              "value": "standard",
              "options": [
                {"value": "standard",  "label": "Стандартная"  },
                {"value": "emotional", "label": "Эмоциональная"},
                {"value": "official",  "label": "Официальная"  }
              ]
            },
            {
              "name": "audience",
              "type": "multiple",
              "label": "Целевая аудитория",
              "required": true,
              "value": null,
              "options": [
                {"value": "families",      "label": "Семьи"         },
                {"value": "children",      "label": "Дети"          },
                {"value": "youth18_25",    "label": "Молодёжь 18-25"},
                {"value": "youth25_40",    "label": "Молодёжь 25-40"},
                {"value": "elderly",       "label": "Пожилые"       },
                {"value": "students",      "label": "Студенты"      },
                {"value": "theatreLovers", "label": "Театралы"      }
              ],
              // Это точно нужно? Вместо minItems и так есть required. А maxItems тут как будто не подходит, т.к. есть спектакли для всех аудиторий
              "validation": {"minItems": 1, "maxItems": 5}
            }
          ]
        }
      ]
    }
  ]
}
